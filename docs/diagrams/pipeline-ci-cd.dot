digraph G {
  graph [rankdir=TB, bgcolor="#F7F9FC", pad="0.30", nodesep="0.40", ranksep="0.55", splines=polyline, fontname="DejaVu Sans"];
  node [shape=box, style="rounded,filled", fillcolor="white", color="#CBD9E7", penwidth=1.3, fontcolor="#19324A", fontname="DejaVu Sans", fontsize=11, margin="0.17,0.13"];
  edge [color="#6387A7", arrowsize=0.7, penwidth=1.5, fontname="DejaVu Sans", fontsize=10, fontcolor="#516982"];
  git [label="Git push\nmain", fillcolor="#E9F3FF"];
  ci [label="CI / tests\nRuff · pytest · build"];
  reg [label="GHCR\nImage sha-<commit>", fillcolor="#E9F3FF"];
  cd [label="CD / SSH\nSHA + clé dédiée"];
  pull [label="Oracle\ndocker pull"];
  backup [label="Sauvegarde\nancien conteneur"];
  boot [label="Nouveau\nconteneur"];
  health [label="GET /health\nmodel_loaded=true", fillcolor="#E5F6ED", color="#8BCFA9"];
  ok [label="Succès\nSupprimer backup", fillcolor="#E5F6ED", color="#8BCFA9"];
  cleanup [label="Nettoyage Docker\nGarder 3 versions", fillcolor="#E5F6ED", color="#8BCFA9"];
  fail [label="Échec\nRestaurer ancien", fillcolor="#FFF0EF", color="#EAA9A7"];
  git -> ci -> reg -> cd -> pull -> backup -> boot -> health;
  health -> ok [label="OK"]; ok -> cleanup;
  health -> fail [label="Échec", color="#CF7776", fontcolor="#B45454"];
  {rank=same; ok; fail}
}
